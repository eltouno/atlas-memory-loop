{
  "description": "Atlas Memory Loop lifecycle capture and bounded recall.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atlas-memory hook --host codex --event UserPromptSubmit --inject --structured-output",
            "statusMessage": "Recalling Memory Loop context",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atlas-memory hook --host codex --event Stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

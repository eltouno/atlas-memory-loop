{
  "description": "Atlas Memory Loop lifecycle capture and bounded recall.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atlas-memory hook --host codex --event SessionStart --inject --structured-output",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atlas-memory hook --host codex --event Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "atlas-memory hook --host codex --event SessionEnd",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
